{
  "name": "gyaku-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "all": "run-s -l format build typecheck test test:*",
    "web": "pnpm -C web run dev",
    "build": "pnpm -C packages/gyaku run build",
    "build:web": "pnpm -C web run build",
    "format": "pnpm -r run format",
    "lint": "pnpm -r run lint",
    "test:example": "pnpm -r run start",
    "test:mutation": "pnpm -C packages/gyaku run test:mutation",
    "test": "pnpm -C packages/gyaku run test",
    "typecheck": "pnpm -r run typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "npm-run-all2": "9.0.3"
  }
}
